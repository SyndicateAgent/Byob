{
  "plugins": {
    "entries": {
      "wecom-openclaw-plugin": {
        "enabled": true
      }
    },
    "load": {
      "paths": [
        "REPLACE_WITH_ABSOLUTE_PATH_TO_BYOB\\openclaw\\state\\npm\\node_modules\\@wecom\\wecom-openclaw-plugin"
      ]
    },
    "allow": [
      "wecom-openclaw-plugin",
      "memory-core"
    ]
  },
  "channels": {
    "wecom": {
      "enabled": true,
      "botId": "REPLACE_WITH_WECOM_BOT_ID",
      "secret": "REPLACE_WITH_WECOM_SECRET",
      "sendThinkingMessage": true,
      "connectionMode": "websocket"
    }
  },
  "mcp": {
    "servers": {
      "byob": {
        "url": "http://127.0.0.1:8010/mcp",
        "transport": "streamable-http"
      }
    }
  },
  "tools": {
    "alsoAllow": [
      "wecom_mcp"
    ]
  }
}
