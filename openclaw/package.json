{
  "name": "byob-openclaw-sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "OpenClaw sidecar wiring for BYOB QA Agent and Enterprise WeChat.",
  "scripts": {
    "apply:wecom-patch": "powershell -ExecutionPolicy Bypass -File scripts/apply-wecom-bridge-patch.ps1",
    "write:config": "powershell -ExecutionPolicy Bypass -File scripts/write-openclaw-config.ps1",
    "gateway": "openclaw gateway run --allow-unconfigured --port 18789 --bind loopback --auth none"
  },
  "dependencies": {
    "openclaw": "2026.5.3"
  }
}
